# Everything that starts with a dot is local tooling
.*

# ...except what the example app needs.
!.gitignore
# Used by `flutter` to upgrade and migrate the project.
!.metadata

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/

# IntelliJ related
*.iml
*.ipr
*.iws
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/